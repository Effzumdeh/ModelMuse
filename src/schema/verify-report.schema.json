{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillspark.local/schema/verify-report.schema.json",
  "title": "VerifyReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelId", "iteration", "layers", "verdict", "failed", "createdAt", "buildHash"],
  "properties": {
    "modelId": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
    "layers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "verdict", "criteria", "durationMs"],
        "properties": {
          "layer": { "type": "string", "enum": ["S1", "S2", "S3", "S4", "S5"] },
          "verdict": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "durationMs": { "type": "number", "minimum": 0 },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "verdict", "expected", "actual"],
              "properties": {
                "id": { "type": "string", "minLength": 2, "maxLength": 64 },
                "verdict": { "type": "string", "enum": ["pass", "fail"] },
                "expected": { "type": "string", "maxLength": 400 },
                "actual": { "type": "string", "maxLength": 400 }
              }
            }
          }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["gruen", "gelb", "rot"] },
    "failed": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" },
    "buildHash": { "type": "string" }
  }
}
