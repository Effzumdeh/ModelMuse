{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmuse.local/schema/manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "track", "objectives", "labels", "measurements", "tasks"],
  "properties": {
    "schemaVersion": { "type": "number", "const": 1.0 },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "track": { "type": "string", "enum": ["SI", "DuP", "AE", "free"] },
    "i18n": {
      "type": "object",
      "description": "Teil 5: EN/ES-Uebersetzungen (UEBERSETZT, nicht neu generiert), Id-Deckung mit kanonischen Messungen/Aufgaben.",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": { "$ref": "#/$defs/i18nLocale" },
        "es": { "$ref": "#/$defs/i18nLocale" }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 8, "maxLength": 240 }
    },
    "quellen": {
      "type": "array",
      "description": "Belegbare Maßquellen für Real-Gebäude (Titel, URL, Stand, wiedergegebene Maße). Optional, für kuratierte generische Modelle leer.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titel", "url", "stand", "mass"],
        "properties": {
          "titel": { "type": "string", "minLength": 3, "maxLength": 160 },
          "url": { "type": "string", "minLength": 8, "maxLength": 300 },
          "stand": { "type": "string", "minLength": 4, "maxLength": 24 },
          "mass": { "type": "string", "minLength": 8, "maxLength": 500 }
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "explanations": {
      "type": "array",
      "description": "Je EINE fachliche Erlaeuterung (1-2 Saetze) pro Label, gleiche Anzahl/Reihenfolge wie labels. Optional im Schema, Pflicht im Release (Verify/Tests pruefen Vorhandensein).",
      "minItems": 3,
      "items": { "type": "string", "minLength": 8, "maxLength": 500 }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "text", "unit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" },
          "from": { "$ref": "#/$defs/vec3" },
          "to": { "$ref": "#/$defs/vec3" },
          "text": { "type": "string", "minLength": 2, "maxLength": 80 },
          "unit": { "type": "string", "enum": ["mm", "cm", "m", "HE", "kB", "MB"] }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "type", "prompt", "expected", "tolerance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{2,24}$" },
          "level": { "type": "string", "enum": ["basis", "aufbau", "profi"] },
          "type": { "type": "string", "enum": ["zuordnung", "messwert", "transfer", "fehlersuche"] },
          "prompt": { "type": "string", "minLength": 8, "maxLength": 400 },
          "expected": { "type": "string", "minLength": 1, "maxLength": 400 },
          "tolerance": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  },
  "$defs": {
    "i18nLocale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "objectives", "labels", "measurements", "tasks"],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 80 },
        "objectives": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 8, "maxLength": 240 } },
        "labels": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "explanations": {
          "type": "array",
          "description": "Uebersetzungen der fachlichen Erlaeuterungen, gleiche Anzahl/Reihenfolge wie labels.",
          "minItems": 3,
          "items": { "type": "string", "minLength": 8, "maxLength": 500 }
        },
        "measurements": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string", "minLength": 2, "maxLength": 80 } } }
        },
        "tasks": {
          "type": "array", "minItems": 1,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "prompt", "expected"], "properties": { "id": { "type": "string" }, "prompt": { "type": "string", "minLength": 8, "maxLength": 400 }, "expected": { "type": "string", "minLength": 1, "maxLength": 400 } } }
        }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": -1000, "maximum": 1000 }
    }
  }
}
