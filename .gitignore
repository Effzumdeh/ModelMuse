# SkillSpark Erst-Commit 2026-10-27 — Versionsverwaltung ab Restposten-Auftrag
# Dependencies
node_modules/
# Keys — nie versionieren (Key_muse.md, Key_openrouter.md, .env)
*Key*.md
*key*.md
.env
.env.*
# Diagnose/Temporaer (O-15): Root-Tmp-Skripte und Logs bleiben lokal
*-tmp.mjs
*-tmp.js
*.log
# dist: ~230 Diagnose-Artefakte lokal; versioniert werden nur Baselines + Audit-Logs
dist/*
!dist/baselines/
!dist/baselines/*
!dist/generation-log.json
!dist/verify-report.json
!dist/build-report.json
!dist/attestation.json
!dist/BACKLOGFIX-REPORT.md
# O-07: letzte gruene Auslieferung lokal (Fallback-Quelle)
dist/last-green/
# OS/Editor
.DS_Store
Thumbs.db
# Playwright-Laufartefakte (Traces, Screenshots, Reports) — lokal, nie versionieren
test-results/
# Bereinigung 2026-10-30 (Inventur): regenerierbar, nie versionieren
cache/
dist/manual-tests/
*.tgz
*.tar.gz
# Strukturelle Hygiene 2026-10-30: generierte Shot-/Report-/Tmp-Artefakte lokal, nie versionieren
# scripts/_tmp/* statt scripts/_tmp/, damit !.gitkeep-Ausnahme greift (Parent-Dir-Exclusion)
scripts/_tmp/*
!scripts/_tmp/.gitkeep
dist-standalone/shots*/
dist-standalone/showcase-harness/
dist-standalone/*-report.json
dist-standalone/SHOWCASE-REPORT-*.md
dist-standalone/STANDALONE-REPORT-*.md
dist-standalone/build-showcase-report.json
dist-standalone/proof-aktuell-*.png
dist-2d/demo-*
docs/routing-shots/
